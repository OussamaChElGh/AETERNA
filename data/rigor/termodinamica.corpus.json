    {
      "id": "wp-es-7372463-d17",
      "type": "definition",
      "text": "Los cuatro principios de la termodinámica son:​​​​​\n\nPrincipio cero de la termodinámica: Si dos sistemas están en equilibrio térmico de manera independiente con un tercer sistema, deben estar en equilibrio térmico entre sí.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Principios_de_la_termodin%C3%A1mica",
      "sourceTitle": "Principios de la termodinámica",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-es-7372463-d18",
      "type": "law",
      "text": "Primer principio de la termodinámica: Un sistema cerrado puede intercambiar energía con su entorno en forma de trabajo y de calor, acumulando energía en forma de energía interna.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Principios_de_la_termodin%C3%A1mica",
      "sourceTitle": "Principios de la termodinámica",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-es-7372463-d19",
      "type": "definition",
      "text": "La ley es una generalización del principio de conservación de la energía mecánica.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Principios_de_la_termodin%C3%A1mica",
      "sourceTitle": "Principios de la termodinámica",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-es-7372463-f20",
      "type": "formula",
      "text": "{\\displaystyle \\Delta U_{sistema}=Q-W}",
      "laTeX": "$${\\displaystyle \\Delta U_{sistema}=Q-W}$$",
      "laTeXNormalized": "\\Delta U_{sistema}=Q-W",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Principios_de_la_termodin%C3%A1mica",
      "sourceTitle": "Principios de la termodinámica",

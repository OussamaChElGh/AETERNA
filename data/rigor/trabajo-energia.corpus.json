    {
      "id": "wp-es-16506-d21",
      "type": "definition",
      "text": "La energía térmica o energía calorífica es la parte de la energía interna de un sistema termodinámico en equilibrio que se proporciona a su temperatura absoluta y se incrementa o disminuye por transferencia de energía, generalmente en forma de calor o trabajo, en procesos termodinámicos.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Energ%C3%ADa_t%C3%A9rmica",
      "sourceTitle": "Energía térmica",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {

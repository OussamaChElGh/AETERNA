    },
    {
      "id": "wp-en-4443-d5",
      "type": "definition",
      "text": "It is the capital and largest city of the autonomous community of Catalonia, as well as the second-most populous municipality of Spain after Madrid.",
      "source": "wikipedia",
      "sourceUrl": "https://en.wikipedia.org/wiki/Barcelona",
      "sourceTitle": "Barcelona",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-en-4443-d6",
      "type": "definition",
      "text": "With a population of 1.7 million within city limits, its urban area extends to numerous neighbouring municipalities within the province of Barcelona and is home to around 5.7 million people, making it the fifth most populous urban area of the European Union after Paris, the Ruhr area, Madrid, and Milan.",
      "source": "wikipedia",
      "sourceUrl": "https://en.wikipedia.org/wiki/Barcelona",
      "sourceTitle": "Barcelona",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {

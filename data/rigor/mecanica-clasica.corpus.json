    {
      "id": "wp-en-71717565-d1",
      "type": "definition",
      "text": "The Faculty of Architecture, Design and Urbanism (Facultad de Arquitectura, Diseño y Urbanismo; FADU) is a faculty of the University of Buenos Aires (UBA), the largest university in Argentina.",
      "source": "wikipedia",
      "sourceUrl": "https://en.wikipedia.org/wiki/Faculty_of_Architecture%2C_Design_and_Urbanism%2C_University_of_Buenos_Aires",
      "sourceTitle": "Faculty of Architecture, Design and Urbanism, University of Buenos Aires",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-en-71717565-d2",
      "type": "definition",
      "text": "Most of the faculty's facilities are located at Pabellón III of the Ciudad Universitaria complex, the UBA's only centralized campus, in the Buenos Aires neighborhood of Núñez.",
      "source": "wikipedia",
      "sourceUrl": "https://en.wikipedia.org/wiki/Faculty_of_Architecture%2C_Design_and_Urbanism%2C_University_of_Buenos_Aires",
      "sourceTitle": "Faculty of Architecture, Design and Urbanism, University of Buenos Aires",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-en-71717565-d3",
      "type": "definition",
      "text": "As of 2011, it was the third-largest faculty at UBA, with 25,748 regular students.",
      "source": "wikipedia",
      "sourceUrl": "https://en.wikipedia.org/wiki/Faculty_of_Architecture%2C_Design_and_Urbanism%2C_University_of_Buenos_Aires",
      "sourceTitle": "Faculty of Architecture, Design and Urbanism, University of Buenos Aires",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90

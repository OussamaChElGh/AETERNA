    {
      "id": "wp-es-390184-d22",
      "type": "definition",
      "text": "La mecánica newtoniana o mecánica vectorial es una formulación específica de la mecánica clásica que estudia el movimiento de partículas y sólidos en un espacio euclídeo tridimensional.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Mec%C3%A1nica_newtoniana",
      "sourceTitle": "Mecánica newtoniana",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-es-390184-d23",
      "type": "definition",
      "text": "La mecánica es la parte de la física que estudia el movimiento.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Mec%C3%A1nica_newtoniana",
      "sourceTitle": "Mecánica newtoniana",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {
      "id": "wp-es-390184-d24",
      "type": "definition",
      "text": "Se subdivide en:\n\nEstática, que trata sobre las fuerzas en equilibrio mecánico.",
      "source": "wikipedia",
      "sourceUrl": "https://es.wikipedia.org/wiki/Mec%C3%A1nica_newtoniana",
      "sourceTitle": "Mecánica newtoniana",
      "tier": "TIER_3_HIGH_QUALITY_WEB",
      "authorityScore": 75,
      "relevanceScore": 90
    },
    {

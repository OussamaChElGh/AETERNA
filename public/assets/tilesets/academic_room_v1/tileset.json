        "/images/anektia_master_oak_floor_tile.png",
        "/images/anektia_master_oak_floor_tile.png"
      ],
      "edges": {
        "N": "/images/anektia_master_oak_floor_tile.png",
        "S": "/images/anektia_master_oak_floor_tile.png",
        "E": "/images/anektia_master_oak_floor_tile.png",
        "W": "/images/anektia_master_oak_floor_tile.png"
      },
      "corners": {
        "NW": "/images/anektia_master_oak_floor_tile.png",
        "NE": "/images/anektia_master_oak_floor_tile.png",
        "SW": "/images/anektia_master_oak_floor_tile.png",
        "SE": "/images/anektia_master_oak_floor_tile.png"
      }
    }
  },
  "skirting": {
    "NW": "/images/anektia_master_oak_floor_tile.png",
    "NE": "/images/anektia_master_oak_floor_tile.png"

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Progreso de gamificación: lectura pública para el cuadro de clasificación,
    // escritura únicamente sobre el propio documento del usuario autenticado.
    match /aeternaProgressV3/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Notificaciones in-app: solo el propietario puede leer y escribir.
    match /aeternaNotifications/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Relaciones de seguimiento (follow unidireccional): solo el propietario lee y escribe.
    match /aeternaFriends/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

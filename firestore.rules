rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Progreso de gamificación: lectura pública para el cuadro de clasificación,
    // escritura únicamente sobre el propio documento del usuario autenticado.
    match /aeternaProgressV3/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
